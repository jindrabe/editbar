{
  "name": "editbar",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/react-app",
    "examples/vue-app",
    "examples/astro-app"
  ],
  "scripts": {
